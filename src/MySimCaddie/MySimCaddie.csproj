<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <RootNamespace>MySimCaddie</RootNamespace>
    <AssemblyName>MySimCaddie</AssemblyName>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>Assets\MySimCaddie.ico</ApplicationIcon>
    <Product>MySimCaddie</Product>
    <Company>JuiceBoxGuy's Hack Shack</Company>
    <Version>0.1.0</Version>

    <!-- Single self-contained exe: copy it to the sim PC and run, no .NET install needed. -->
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>true</SelfContained>
    <PublishSingleFile>true</PublishSingleFile>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <EnableCompressionInSingleFile>true</EnableCompressionInSingleFile>
    <DebugType>embedded</DebugType>
  </PropertyGroup>

  <ItemGroup>
    <Resource Include="Assets\MySimCaddie.ico" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\MySimCaddie.Core\MySimCaddie.Core.csproj" />
  </ItemGroup>

</Project>
