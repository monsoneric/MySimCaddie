<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- ── Palette: bright modern ── -->
    <Color x:Key="InkColor">#0F172A</Color>
    <Color x:Key="MutedColor">#64748B</Color>
    <Color x:Key="LineColor">#E2E8F0</Color>
    <Color x:Key="CanvasTopColor">#F8FAFC</Color>
    <Color x:Key="CanvasBottomColor">#EEF5F0</Color>

    <SolidColorBrush x:Key="InkBrush" Color="{StaticResource InkColor}" />
    <SolidColorBrush x:Key="MutedBrush" Color="{StaticResource MutedColor}" />
    <SolidColorBrush x:Key="LineBrush" Color="{StaticResource LineColor}" />
    <SolidColorBrush x:Key="CardBrush" Color="#F2FFFFFF" />
    <SolidColorBrush x:Key="SolidCardBrush" Color="White" />
    <SolidColorBrush x:Key="OkBrush" Color="#16A34A" />
    <SolidColorBrush x:Key="WarnBrush" Color="#D97706" />
    <SolidColorBrush x:Key="BadBrush" Color="#DC2626" />
    <SolidColorBrush x:Key="IdleBrush" Color="#CBD5E1" />

    <!-- Replaced at runtime from config.accentColor -->
    <SolidColorBrush x:Key="AccentBrush" Color="#16A34A" />
    <SolidColorBrush x:Key="AccentSoftBrush" Color="#DCFCE7" />

    <FontFamily x:Key="DisplayFont">Segoe UI Variable Display, Segoe UI</FontFamily>
    <FontFamily x:Key="TextFont">Segoe UI Variable Text, Segoe UI</FontFamily>
    <FontFamily x:Key="IconFont">Segoe Fluent Icons, Segoe MDL2 Assets</FontFamily>

    <DropShadowEffect x:Key="CardShadow" BlurRadius="28" ShadowDepth="6" Direction="270" Opacity="0.10" Color="#0F172A" />
    <DropShadowEffect x:Key="CardShadowLifted" BlurRadius="40" ShadowDepth="12" Direction="270" Opacity="0.18" Color="#0F172A" />

    <!-- Font only: foreground is inherited (windows set InkBrush) so text inside white-on-accent buttons stays white. -->
    <Style TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource TextFont}" />
    </Style>

    <Style x:Key="Icon" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource IconFont}" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="HorizontalAlignment" Value="Center" />
    </Style>

    <Style x:Key="SectionLabel" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource TextFont}" />
        <Setter Property="FontSize" Value="18" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{StaticResource MutedBrush}" />
        <Setter Property="Margin" Value="4,0,0,16" />
    </Style>

    <!-- ── Big profile tile ── -->
    <Style x:Key="TileButton" TargetType="Button">
        <Setter Property="Width" Value="400" />
        <Setter Property="Height" Value="300" />
        <Setter Property="Margin" Value="0,0,32,32" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Card" CornerRadius="28" Background="{StaticResource SolidCardBrush}"
                            BorderBrush="{StaticResource LineBrush}" BorderThickness="2"
                            Effect="{StaticResource CardShadow}" Padding="32,30">
                        <ContentPresenter />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Card" Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
                            <Setter TargetName="Card" Property="Effect" Value="{StaticResource CardShadowLifted}" />
                        </Trigger>
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter TargetName="Card" Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
                            <Setter TargetName="Card" Property="BorderThickness" Value="4" />
                            <Setter TargetName="Card" Property="Effect" Value="{StaticResource CardShadowLifted}" />
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Card" Property="Background" Value="{DynamicResource AccentSoftBrush}" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="Card" Property="Opacity" Value="0.55" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ── Pill buttons (quick launch, footer actions) ── -->
    <Style x:Key="PillButton" TargetType="Button">
        <Setter Property="Height" Value="56" />
        <Setter Property="Margin" Value="0,0,16,16" />
        <Setter Property="Padding" Value="22,0" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="FontSize" Value="18" />
        <Setter Property="FontFamily" Value="{StaticResource TextFont}" />
        <Setter Property="Foreground" Value="{StaticResource InkBrush}" />
        <Setter Property="Background" Value="{StaticResource CardBrush}" />
        <Setter Property="BorderBrush" Value="{StaticResource LineBrush}" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Pill" CornerRadius="28" Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="2" Padding="{TemplateBinding Padding}">
                        <ContentPresenter VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Pill" Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
                        </Trigger>
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter TargetName="Pill" Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
                            <Setter TargetName="Pill" Property="BorderThickness" Value="3" />
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Pill" Property="Background" Value="{DynamicResource AccentSoftBrush}" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="Pill" Property="Opacity" Value="0.5" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="PrimaryPill" TargetType="Button" BasedOn="{StaticResource PillButton}">
        <Setter Property="Background" Value="{DynamicResource AccentBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
        <Setter Property="Foreground" Value="White" />
        <Setter Property="FontWeight" Value="SemiBold" />
    </Style>

    <Style x:Key="DangerPill" TargetType="Button" BasedOn="{StaticResource PillButton}">
        <Setter Property="Background" Value="White" />
        <Setter Property="BorderBrush" Value="{StaticResource BadBrush}" />
        <Setter Property="Foreground" Value="{StaticResource BadBrush}" />
        <Setter Property="FontWeight" Value="SemiBold" />
    </Style>

    <!-- ── Status chips ── -->
    <Style x:Key="Chip" TargetType="Border">
        <Setter Property="CornerRadius" Value="18" />
        <Setter Property="Background" Value="{StaticResource SolidCardBrush}" />
        <Setter Property="BorderBrush" Value="{StaticResource LineBrush}" />
        <Setter Property="BorderThickness" Value="1.5" />
        <Setter Property="Padding" Value="14,7" />
        <Setter Property="Margin" Value="0,0,10,0" />
    </Style>

    <!-- ── Setup form controls ── -->
    <Style TargetType="TextBox">
        <Setter Property="FontSize" Value="17" />
        <Setter Property="FontFamily" Value="{StaticResource TextFont}" />
        <Setter Property="Padding" Value="10,8" />
        <Setter Property="BorderBrush" Value="{StaticResource LineBrush}" />
        <Setter Property="BorderThickness" Value="2" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
    </Style>

    <Style TargetType="ComboBox">
        <Setter Property="FontSize" Value="17" />
        <Setter Property="FontFamily" Value="{StaticResource TextFont}" />
        <Setter Property="Padding" Value="10,8" />
        <Setter Property="Height" Value="44" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
    </Style>

    <Style TargetType="CheckBox">
        <Setter Property="FontSize" Value="17" />
        <Setter Property="FontFamily" Value="{StaticResource TextFont}" />
        <Setter Property="Foreground" Value="{StaticResource InkBrush}" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="Margin" Value="0,6" />
    </Style>

</ResourceDictionary>
