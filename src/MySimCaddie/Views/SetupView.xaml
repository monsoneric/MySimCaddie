<UserControl x:Class="MySimCaddie.Views.SetupView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:views="clr-namespace:MySimCaddie.Views">

    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis" />

        <Style x:Key="FieldLabel" TargetType="TextBlock">
            <Setter Property="FontSize" Value="17" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>

        <Style x:Key="Hint" TargetType="TextBlock">
            <Setter Property="FontSize" Value="14" />
            <Setter Property="Foreground" Value="{StaticResource MutedBrush}" />
            <Setter Property="TextWrapping" Value="Wrap" />
        </Style>

        <Style x:Key="IconButton" TargetType="Button" BasedOn="{StaticResource PillButton}">
            <Setter Property="Height" Value="42" />
            <Setter Property="Padding" Value="13,0" />
            <Setter Property="Margin" Value="8,0,0,0" />
        </Style>

        <Style x:Key="ScenarioItem" TargetType="ListBoxItem">
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border x:Name="Bd" CornerRadius="16" Padding="14,12" Margin="0,0,0,8" Background="White"
                                BorderBrush="{StaticResource LineBrush}" BorderThickness="2">
                            <ContentPresenter />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource AccentSoftBrush}" />
                                <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <Grid x:Name="Root" Background="#C7F8FAFC">
        <Border Width="1500" Height="980" HorizontalAlignment="Center" VerticalAlignment="Center"
                Background="{StaticResource SolidCardBrush}" CornerRadius="32" Effect="{StaticResource CardShadowLifted}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <!-- ── Header: title, tabs, always-visible Back / Save ── -->
                <Grid Margin="56,36,56,12">
                    <StackPanel Orientation="Horizontal">
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="SETUP" FontSize="17" FontWeight="Bold" Foreground="{DynamicResource AccentBrush}" />
                            <TextBlock Text="Your room" FontFamily="{StaticResource DisplayFont}" FontSize="40" FontWeight="SemiBold" />
                        </StackPanel>
                        <Button x:Name="RoomTabButton" Style="{StaticResource PrimaryPill}" Click="RoomTab_Click" Margin="48,0,12,0" VerticalAlignment="Center">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Style="{StaticResource Icon}" Text="&#xE80F;" FontSize="18" />
                                <TextBlock Text="Room &amp; apps" FontSize="18" Margin="10,0,0,0" VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>
                        <Button x:Name="ScenariosTabButton" Style="{StaticResource PillButton}" Click="ScenariosTab_Click" Margin="0" VerticalAlignment="Center">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Style="{StaticResource Icon}" Text="&#xE7C1;" FontSize="18" />
                                <TextBlock Text="Scenarios" FontSize="18" Margin="10,0,0,0" VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>
                    </StackPanel>

                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                        <Button Style="{StaticResource PillButton}" Click="Cancel_Click" Margin="0" ToolTip="Back to the home screen without saving (Esc)">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Style="{StaticResource Icon}" Text="&#xE72B;" FontSize="18" />
                                <TextBlock Text="Back" FontSize="18" Margin="10,0,0,0" VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>
                        <Button Style="{StaticResource PrimaryPill}" Click="Save_Click" Margin="14,0,0,0" ToolTip="Save and go back to the home screen">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Style="{StaticResource Icon}" Text="&#xE73E;" FontSize="18" />
                                <TextBlock Text="Save &amp; close" FontSize="18" Margin="10,0,0,0" VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </Grid>

                <Grid Grid.Row="1">
                    <!-- ── Room & apps tab ── -->
                    <ScrollViewer x:Name="RoomPanel" VerticalScrollBarVisibility="Auto" Padding="56,8,56,8" Focusable="False">
                        <StackPanel>

                            <!-- Displays -->
                            <Grid Margin="0,8,0,12">
                                <TextBlock Text="Displays" Style="{StaticResource SectionLabel}" Margin="0" FontSize="22" Foreground="{StaticResource InkBrush}" />
                                <Button Style="{StaticResource PillButton}" HorizontalAlignment="Right" Height="46" Margin="0" Click="Identify_Click">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Style="{StaticResource Icon}" Text="&#xE7F4;" FontSize="16" />
                                        <TextBlock Text="Identify displays" FontSize="16" Margin="10,0,0,0" VerticalAlignment="Center" />
                                    </StackPanel>
                                </Button>
                            </Grid>

                            <ItemsControl ItemsSource="{Binding Roles}" Focusable="False">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Grid Margin="0,0,0,12">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="220" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <StackPanel VerticalAlignment="Center">
                                                <TextBlock Text="{Binding Role}" FontSize="19" FontWeight="SemiBold" />
                                                <TextBlock Text="{Binding Hint}" FontSize="14" Foreground="{StaticResource MutedBrush}" />
                                            </StackPanel>
                                            <ComboBox Grid.Column="1" ItemsSource="{Binding Options}" SelectedItem="{Binding Selected}"
                                                      DisplayMemberPath="Text" />
                                        </Grid>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>

                            <CheckBox Content="Make the Projector the main Windows display when MySimCaddie starts (GSPro opens full-screen on the main display)"
                                      IsChecked="{Binding ProjectorPrimaryAtStartup}" Margin="220,4,0,0" />

                            <!-- Apps -->
                            <TextBlock Text="Apps" Style="{StaticResource SectionLabel}" Margin="0,32,0,4" FontSize="22" Foreground="{StaticResource InkBrush}" />
                            <TextBlock Text="Point each app at its .exe. GSPro uses GSPLauncher.exe; GSPro Connect is what links the Bushnell Launch Pro. Apps added here can be used in Scenarios."
                                       FontSize="15" Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap" Margin="0,0,0,14" />

                            <ItemsControl ItemsSource="{Binding Apps}" Focusable="False">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Grid Margin="0,0,0,14">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="220" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <StackPanel VerticalAlignment="Center" Margin="0,0,16,0">
                                                <TextBox Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}" FontWeight="SemiBold" Height="40" Padding="8,4" />
                                                <TextBlock Text="{Binding Status}" FontSize="14" Foreground="{Binding StatusBrush}" Margin="2,4,0,0" />
                                            </StackPanel>
                                            <TextBox Grid.Column="1" Text="{Binding Path, UpdateSourceTrigger=PropertyChanged}" Height="46" />
                                            <Button Grid.Column="2" Style="{StaticResource PillButton}" Height="46" Margin="12,0,0,0" Padding="18,0"
                                                    Click="BrowseApp_Click" Content="Browse…" FontSize="16" />
                                            <CheckBox Grid.Column="3" Content="Run as admin" IsChecked="{Binding RunAsAdmin}" Margin="16,0,0,0" FontSize="15" />
                                            <Button Grid.Column="4" Style="{StaticResource PillButton}" Height="46" Margin="12,0,0,0" Padding="14,0"
                                                    Click="RemoveApp_Click" ToolTip="Remove this app">
                                                <TextBlock Style="{StaticResource Icon}" Text="&#xE74D;" FontSize="16" />
                                            </Button>
                                        </Grid>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>

                            <Button Style="{StaticResource PillButton}" Height="46" Padding="18,0" Click="AddApp_Click" HorizontalAlignment="Left">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Style="{StaticResource Icon}" Text="&#xE710;" FontSize="16" />
                                    <TextBlock Text="Add an app (E6 Connect, FSX, ShotForge…)" FontSize="16" Margin="10,0,0,0" VerticalAlignment="Center" />
                                </StackPanel>
                            </Button>

                            <!-- Look -->
                            <TextBlock Text="Look" Style="{StaticResource SectionLabel}" Margin="0,32,0,14" FontSize="22" Foreground="{StaticResource InkBrush}" />

                            <Grid Margin="0,0,0,14">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="220" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="Room name" FontSize="19" FontWeight="SemiBold" VerticalAlignment="Center" />
                                <TextBox Grid.Column="1" Text="{Binding RoomName, UpdateSourceTrigger=PropertyChanged}" Height="46" />
                            </Grid>

                            <Grid Margin="0,0,0,14">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="220" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="Logo" FontSize="19" FontWeight="SemiBold" VerticalAlignment="Center" />
                                <TextBox Grid.Column="1" Text="{Binding LogoPath, UpdateSourceTrigger=PropertyChanged}" Height="46" />
                                <Button Grid.Column="2" Style="{StaticResource PillButton}" Height="46" Margin="12,0,0,0" Padding="18,0"
                                        Click="BrowseLogo_Click" Content="Browse…" FontSize="16" />
                                <Button Grid.Column="3" Style="{StaticResource PillButton}" Height="46" Margin="12,0,0,0" Padding="18,0"
                                        Click="ClearLogo_Click" Content="Clear" FontSize="16" />
                            </Grid>

                            <Grid Margin="0,0,0,14">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="220" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="Tile position" FontSize="19" FontWeight="SemiBold" VerticalAlignment="Center" />
                                <ComboBox Grid.Column="1" ItemsSource="{x:Static views:SetupChoices.TileLayouts}" DisplayMemberPath="Text"
                                          SelectedValuePath="Value" SelectedValue="{Binding TileLayout}" />
                            </Grid>

                            <Grid Margin="0,0,0,14">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="220" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="80" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="Logo visibility" FontSize="19" FontWeight="SemiBold" VerticalAlignment="Center" />
                                <Slider Grid.Column="1" Minimum="0" Maximum="1" Value="{Binding LogoOpacity}" VerticalAlignment="Center"
                                        SmallChange="0.05" LargeChange="0.1" />
                                <TextBlock Grid.Column="2" Text="{Binding LogoOpacity, StringFormat={}{0:P0}}" FontSize="17"
                                           VerticalAlignment="Center" HorizontalAlignment="Right" />
                            </Grid>

                            <!-- System -->
                            <TextBlock Text="System" Style="{StaticResource SectionLabel}" Margin="0,32,0,8" FontSize="22" Foreground="{StaticResource InkBrush}" />
                            <CheckBox Content="Start MySimCaddie when I sign in to Windows" IsChecked="{Binding StartWithWindows}" />
                            <CheckBox Content="Run MySimCaddie as administrator" IsChecked="{Binding RunElevated}" />
                            <TextBlock FontSize="14" Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap" Margin="28,0,0,0"
                                       Text="Turn this on if GSPro (or any app) is set to Run as admin — otherwise Windows won't let MySimCaddie press Play! for you. Windows asks once to allow it; after that it starts as administrator with no prompt." />
                            <StackPanel Orientation="Horizontal" Margin="0,14,0,12">
                                <Button Style="{StaticResource PillButton}" Height="46" Padding="18,0" Click="OpenConfigFolder_Click"
                                        Content="Open config folder (advanced)" FontSize="16" />
                                <Button Style="{StaticResource PillButton}" Height="46" Padding="18,0" Click="OpenLogs_Click"
                                        Content="Open logs" FontSize="16" />
                            </StackPanel>
                        </StackPanel>
                    </ScrollViewer>

                    <!-- ── Scenarios tab ── -->
                    <Grid x:Name="ScenariosPanel" Margin="56,8,56,8" Visibility="Collapsed">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="340" />
                            <ColumnDefinition Width="36" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <!-- Scenario list -->
                        <DockPanel>
                            <TextBlock DockPanel.Dock="Top" Text="Tiles on the home screen" Style="{StaticResource Hint}" FontSize="15" Margin="2,0,0,10" />
                            <StackPanel DockPanel.Dock="Bottom" Margin="0,8,0,0">
                                <Button Style="{StaticResource PrimaryPill}" Click="NewScenario_Click" Margin="0,0,0,10" Height="48">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Style="{StaticResource Icon}" Text="&#xE710;" FontSize="16" />
                                        <TextBlock Text="New scenario" FontSize="17" Margin="10,0,0,0" VerticalAlignment="Center" />
                                    </StackPanel>
                                </Button>
                                <StackPanel Orientation="Horizontal">
                                    <Button Style="{StaticResource IconButton}" Margin="0" Click="MoveScenarioUp_Click" ToolTip="Move up">
                                        <TextBlock Style="{StaticResource Icon}" Text="&#xE70E;" FontSize="16" />
                                    </Button>
                                    <Button Style="{StaticResource IconButton}" Click="MoveScenarioDown_Click" ToolTip="Move down">
                                        <TextBlock Style="{StaticResource Icon}" Text="&#xE70D;" FontSize="16" />
                                    </Button>
                                    <Button Style="{StaticResource IconButton}" Click="DuplicateScenario_Click" ToolTip="Duplicate">
                                        <TextBlock Style="{StaticResource Icon}" Text="&#xE8C8;" FontSize="16" />
                                    </Button>
                                    <Button Style="{StaticResource IconButton}" Click="DeleteScenario_Click" ToolTip="Delete (tap twice)">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Style="{StaticResource Icon}" Text="&#xE74D;" FontSize="16" Foreground="{StaticResource BadBrush}" />
                                            <TextBlock Text="Delete" FontSize="15" Margin="8,0,0,0" VerticalAlignment="Center" Foreground="{StaticResource BadBrush}" />
                                        </StackPanel>
                                    </Button>
                                </StackPanel>
                            </StackPanel>

                            <ListBox ItemsSource="{Binding Profiles}" SelectedItem="{Binding SelectedProfile}"
                                     ItemContainerStyle="{StaticResource ScenarioItem}" BorderThickness="0" Background="Transparent"
                                     ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <StackPanel Orientation="Horizontal">
                                            <Border Width="44" Height="44" CornerRadius="12" Background="{Binding AccentBrush}">
                                                <TextBlock Style="{StaticResource Icon}" Text="{Binding Glyph}" FontSize="20" Foreground="White" />
                                            </Border>
                                            <StackPanel Margin="12,0,0,0" VerticalAlignment="Center" Width="230">
                                                <TextBlock Text="{Binding Name}" FontSize="18" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                                <TextBlock Text="{Binding Subtitle}" FontSize="13" Foreground="{StaticResource MutedBrush}" TextTrimming="CharacterEllipsis" />
                                            </StackPanel>
                                        </StackPanel>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                        </DockPanel>

                        <!-- Scenario editor -->
                        <TextBlock Grid.Column="2" Text="Pick a scenario on the left, or make a new one." FontSize="18"
                                   Foreground="{StaticResource MutedBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                        <ScrollViewer Grid.Column="2" VerticalScrollBarVisibility="Auto" Focusable="False" Background="White"
                                      Visibility="{Binding HasSelectedProfile, Converter={StaticResource BoolToVis}}">
                            <StackPanel DataContext="{Binding SelectedProfile}" Margin="0,0,16,0">

                                <Grid Margin="0,0,0,12">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="170" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="Name" Style="{StaticResource FieldLabel}" />
                                    <TextBox Grid.Column="1" Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}" Height="44" />
                                </Grid>

                                <Grid Margin="0,0,0,12">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="170" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="Subtitle" Style="{StaticResource FieldLabel}" />
                                    <TextBox Grid.Column="1" Text="{Binding Subtitle, UpdateSourceTrigger=PropertyChanged}" Height="44" />
                                </Grid>

                                <Grid Margin="0,0,0,12">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="170" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="24" />
                                        <ColumnDefinition Width="90" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="Icon" Style="{StaticResource FieldLabel}" />
                                    <ComboBox Grid.Column="1" ItemsSource="{x:Static views:SetupChoices.Icons}"
                                              SelectedValuePath="Hex" SelectedValue="{Binding Icon}">
                                        <ComboBox.ItemTemplate>
                                            <DataTemplate>
                                                <StackPanel Orientation="Horizontal">
                                                    <TextBlock Style="{StaticResource Icon}" Text="{Binding Glyph}" FontSize="18" Width="28" />
                                                    <TextBlock Text="{Binding Name}" FontSize="16" Margin="8,0,0,0" VerticalAlignment="Center" />
                                                </StackPanel>
                                            </DataTemplate>
                                        </ComboBox.ItemTemplate>
                                    </ComboBox>
                                    <TextBlock Grid.Column="3" Text="Color" Style="{StaticResource FieldLabel}" />
                                    <ComboBox Grid.Column="4" ItemsSource="{x:Static views:SetupChoices.Colors}"
                                              SelectedValuePath="Hex" SelectedValue="{Binding AccentColor}">
                                        <ComboBox.ItemTemplate>
                                            <DataTemplate>
                                                <StackPanel Orientation="Horizontal">
                                                    <Ellipse Width="18" Height="18" Fill="{Binding Brush}" VerticalAlignment="Center" />
                                                    <TextBlock Text="{Binding Name}" FontSize="16" Margin="10,0,0,0" VerticalAlignment="Center" />
                                                </StackPanel>
                                            </DataTemplate>
                                        </ComboBox.ItemTemplate>
                                    </ComboBox>
                                </Grid>

                                <Grid Margin="0,0,0,4">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="170" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="Main display" Style="{StaticResource FieldLabel}" />
                                    <ComboBox Grid.Column="1" ItemsSource="{x:Static views:SetupChoices.PrimaryDisplays}"
                                              DisplayMemberPath="Text" SelectedValuePath="Value" SelectedValue="{Binding PrimaryDisplay}" />
                                </Grid>
                                <TextBlock Text="Games open full-screen on the main display, so GSPro / E6 scenarios should use the Projector."
                                           Style="{StaticResource Hint}" Margin="170,0,0,4" />
                                <CheckBox Content="Put the previous main display back when the round ends" IsChecked="{Binding RestorePrimaryOnEnd}"
                                          Margin="170,0,0,0" FontSize="15" />

                                <!-- Steps -->
                                <TextBlock Text="Launch steps, in order" FontSize="21" FontWeight="SemiBold" Margin="0,26,0,2" />
                                <TextBlock Style="{StaticResource Hint}" Margin="0,0,0,10"
                                           Text="For each step, pick an app from the list or press Browse… to find a program's .exe." />
                                <ItemsControl ItemsSource="{Binding Steps}" Focusable="False">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border CornerRadius="18" BorderBrush="{StaticResource LineBrush}" BorderThickness="2"
                                                    Padding="16,14" Margin="0,0,0,12" Background="#FAFCFB">
                                                <StackPanel>
                                                    <Grid>
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="44" />
                                                            <ColumnDefinition Width="*" />
                                                            <ColumnDefinition Width="Auto" />
                                                        </Grid.ColumnDefinitions>
                                                        <Border Width="32" Height="32" CornerRadius="16" Background="{DynamicResource AccentSoftBrush}" HorizontalAlignment="Left">
                                                            <TextBlock Text="{Binding Number}" FontWeight="Bold" FontSize="15" Foreground="{DynamicResource AccentBrush}"
                                                                       HorizontalAlignment="Center" VerticalAlignment="Center" />
                                                        </Border>
                                                        <ComboBox Grid.Column="1" ItemsSource="{Binding AppOptions}" DisplayMemberPath="Name"
                                                                  SelectedValuePath="Id" SelectedValue="{Binding AppId}" ToolTip="Pick an app you've already added, or use Browse to find a program" />
                                                        <StackPanel Grid.Column="2" Orientation="Horizontal">
                                                            <Button Style="{StaticResource IconButton}" Click="BrowseStepApp_Click" ToolTip="Find the program's .exe on this PC">
                                                                <StackPanel Orientation="Horizontal">
                                                                    <TextBlock Style="{StaticResource Icon}" Text="&#xE8B7;" FontSize="15" />
                                                                    <TextBlock Text="Browse…" FontSize="15" Margin="8,0,0,0" VerticalAlignment="Center" />
                                                                </StackPanel>
                                                            </Button>
                                                            <Button Style="{StaticResource IconButton}" Click="StepUp_Click" ToolTip="Earlier">
                                                                <TextBlock Style="{StaticResource Icon}" Text="&#xE70E;" FontSize="14" />
                                                            </Button>
                                                            <Button Style="{StaticResource IconButton}" Click="StepDown_Click" ToolTip="Later">
                                                                <TextBlock Style="{StaticResource Icon}" Text="&#xE70D;" FontSize="14" />
                                                            </Button>
                                                            <Button Style="{StaticResource IconButton}" Click="RemoveStep_Click" ToolTip="Remove step">
                                                                <TextBlock Style="{StaticResource Icon}" Text="&#xE711;" FontSize="14" Foreground="{StaticResource BadBrush}" />
                                                            </Button>
                                                        </StackPanel>
                                                    </Grid>

                                                    <WrapPanel Margin="44,12,0,0">
                                                        <TextBlock Text="Put it on" FontSize="15" VerticalAlignment="Center" Margin="0,0,10,0" />
                                                        <ComboBox Width="200" ItemsSource="{x:Static views:SetupChoices.Displays}" DisplayMemberPath="Text"
                                                                  SelectedValuePath="Value" SelectedValue="{Binding Display}" Margin="0,0,10,0" />
                                                        <ComboBox Width="230" ItemsSource="{x:Static views:SetupChoices.Windows}" DisplayMemberPath="Text"
                                                                  SelectedValuePath="Value" SelectedValue="{Binding Window}" Margin="0,0,18,0" />
                                                        <CheckBox Content="Close it when the round ends" IsChecked="{Binding CloseOnEnd}" FontSize="15" />
                                                    </WrapPanel>

                                                    <StackPanel Orientation="Horizontal" Margin="44,10,0,0"
                                                                Visibility="{Binding HasAutoClick, Converter={StaticResource BoolToVis}}">
                                                        <TextBlock Style="{StaticResource Icon}" Text="&#xE8B0;" FontSize="15" Foreground="{DynamicResource AccentBrush}" />
                                                        <TextBlock Text="{Binding AutoClickSummary}" FontSize="15" Margin="8,0,0,0" Foreground="{DynamicResource AccentBrush}" />
                                                    </StackPanel>

                                                    <Expander Header="More options" Margin="44,10,0,0" FontSize="14" Foreground="{StaticResource MutedBrush}">
                                                        <StackPanel Margin="0,10,0,0">
                                                            <WrapPanel>
                                                                <TextBlock Text="Wait for program" FontSize="14" VerticalAlignment="Center" Margin="0,0,8,0" Foreground="{StaticResource InkBrush}" />
                                                                <TextBox Width="170" Height="38" FontSize="14" Text="{Binding WaitForProcess, UpdateSourceTrigger=PropertyChanged}"
                                                                         ToolTip="For launchers that open a different program, e.g. GSPLauncher opens GSPro" Margin="0,0,16,6" />
                                                                <TextBlock Text="Max wait (s)" FontSize="14" VerticalAlignment="Center" Margin="0,0,8,0" Foreground="{StaticResource InkBrush}" />
                                                                <TextBox Width="70" Height="38" FontSize="14" Text="{Binding WaitTimeoutSeconds}" Margin="0,0,16,6" />
                                                                <TextBlock Text="Pause after (s)" FontSize="14" VerticalAlignment="Center" Margin="0,0,8,0" Foreground="{StaticResource InkBrush}" />
                                                                <TextBox Width="70" Height="38" FontSize="14" Text="{Binding DelayAfterSeconds}" Margin="0,0,16,6" />
                                                            </WrapPanel>
                                                            <WrapPanel Margin="0,4,0,0">
                                                                <TextBlock Text="If already running" FontSize="14" VerticalAlignment="Center" Margin="0,0,8,0" Foreground="{StaticResource InkBrush}" />
                                                                <ComboBox Width="230" Height="38" FontSize="14" ItemsSource="{x:Static views:SetupChoices.IfRunning}" DisplayMemberPath="Text"
                                                                          SelectedValuePath="Value" SelectedValue="{Binding IfRunning}" Margin="0,0,16,6" />
                                                                <CheckBox Content="Don't wait for it before the next step" IsChecked="{Binding WaitInBackground}" FontSize="14"
                                                                          Foreground="{StaticResource InkBrush}" />
                                                            </WrapPanel>
                                                            <WrapPanel Margin="0,8,0,0">
                                                                <TextBlock Text="Auto-press button" FontSize="14" VerticalAlignment="Center" Margin="0,0,8,0" Foreground="{StaticResource InkBrush}" />
                                                                <TextBox Width="110" Height="38" FontSize="14" Text="{Binding AutoClickButton, UpdateSourceTrigger=PropertyChanged}"
                                                                         ToolTip="Button text, e.g. Play!" Margin="0,0,8,6" />
                                                                <TextBlock Text="in the pop-up titled" FontSize="14" VerticalAlignment="Center" Margin="0,0,8,0" Foreground="{StaticResource InkBrush}" />
                                                                <TextBox Width="200" Height="38" FontSize="14" Text="{Binding AutoClickWindow, UpdateSourceTrigger=PropertyChanged}"
                                                                         ToolTip="Part of the pop-up window's title, e.g. GSPro Configuration" Margin="0,0,12,6" />
                                                                <Button Style="{StaticResource IconButton}" Margin="0,0,0,6" Height="38" Click="GsproPreset_Click"
                                                                        Content="Use GSPro's Play! + Connect" FontSize="14" ToolTip="Fill in GSPro's launcher pop-up and GSPro Connect's Connect button" />
                                                            </WrapPanel>
                                                            <WrapPanel Margin="0,4,0,0">
                                                                <TextBlock Text="Then, if it shows up, press" FontSize="14" VerticalAlignment="Center" Margin="0,0,8,0" Foreground="{StaticResource InkBrush}" />
                                                                <TextBox Width="110" Height="38" FontSize="14" Text="{Binding AutoClick2Button, UpdateSourceTrigger=PropertyChanged}"
                                                                         ToolTip="Button text, e.g. Connect" Margin="0,0,8,6" />
                                                                <TextBlock Text="in the window titled" FontSize="14" VerticalAlignment="Center" Margin="0,0,8,0" Foreground="{StaticResource InkBrush}" />
                                                                <TextBox Width="200" Height="38" FontSize="14" Text="{Binding AutoClick2Window, UpdateSourceTrigger=PropertyChanged}"
                                                                         ToolTip="Part of the window's title, e.g. GSPro x Foresight. It waits a few seconds first in case it connects by itself." Margin="0,0,12,6" />
                                                            </WrapPanel>
                                                        </StackPanel>
                                                    </Expander>
                                                </StackPanel>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                                <Button Style="{StaticResource PillButton}" Click="AddStep_Click" HorizontalAlignment="Left" Height="46">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Style="{StaticResource Icon}" Text="&#xE710;" FontSize="16" />
                                        <TextBlock Text="Add step" FontSize="16" Margin="10,0,0,0" VerticalAlignment="Center" />
                                    </StackPanel>
                                </Button>

                                <!-- End of round -->
                                <TextBlock Text="When the round ends" FontSize="21" FontWeight="SemiBold" Margin="0,22,0,10" />
                                <Grid Margin="0,0,0,4">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="300" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="The round is over when this closes" Style="{StaticResource FieldLabel}" FontSize="16" />
                                    <ComboBox Grid.Column="1" IsEditable="True" ItemsSource="{Binding SessionSuggestions}"
                                              Text="{Binding SessionProcess, UpdateSourceTrigger=PropertyChanged}" />
                                </Grid>
                                <TextBlock Style="{StaticResource Hint}" Margin="300,0,0,12"
                                           Text="Usually the game (GSPro, E6Connect…). Leave blank to just open the apps and go back to the home screen." />

                                <TextBlock Text="Then also close" Style="{StaticResource FieldLabel}" FontSize="16" Margin="0,0,0,6" />
                                <ItemsControl ItemsSource="{Binding AlsoCloseOptions}" Focusable="False" Margin="0,0,0,8">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <WrapPanel />
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <CheckBox Content="{Binding Name}" IsChecked="{Binding IsChecked}" Margin="0,4,24,4" FontSize="15" />
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                                <TextBlock Style="{StaticResource Hint}" Margin="0,0,0,8"
                                           Text="Apps from steps marked “Close it when the round ends” are closed too." />

                                <CheckBox Content="Start this scenario automatically when MySimCaddie opens at Windows sign-in"
                                          IsChecked="{Binding AutoRun}" Margin="0,14,0,20" />
                            </StackPanel>
                        </ScrollViewer>
                    </Grid>
                </Grid>

                <!-- ── Footer ── -->
                <Border Grid.Row="2" BorderBrush="{StaticResource LineBrush}" BorderThickness="0,1.5,0,0" Padding="56,18,56,4">
                    <Grid>
                        <TextBlock Text="{Binding Message}" FontSize="16" Foreground="{DynamicResource AccentBrush}" FontWeight="SemiBold"
                                   VerticalAlignment="Center" TextWrapping="Wrap" Margin="0,0,24,12" MaxWidth="820" HorizontalAlignment="Left" />
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                            <Button Style="{StaticResource PillButton}" Click="Cancel_Click" Content="Back without saving" Padding="30,0" />
                            <Button Style="{StaticResource PrimaryPill}" Click="Save_Click" Content="Save &amp; close" Padding="40,0" Margin="0,0,0,16" />
                        </StackPanel>
                    </Grid>
                </Border>
            </Grid>
        </Border>
    </Grid>
</UserControl>
