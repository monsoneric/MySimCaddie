<Window x:Class="MySimCaddie.Views.IdentifyWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Identify display"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ResizeMode="NoResize"
        Foreground="{StaticResource InkBrush}"
        Topmost="True"
        ShowInTaskbar="False"
        ShowActivated="False"
        Width="800" Height="600"
        MouseDown="Window_MouseDown">
    <Grid Background="#40FFFFFF">
        <Border HorizontalAlignment="Center" VerticalAlignment="Center" Background="{StaticResource SolidCardBrush}"
                CornerRadius="36" Padding="80,48" BorderBrush="{DynamicResource AccentBrush}" BorderThickness="6"
                Effect="{StaticResource CardShadowLifted}">
            <StackPanel HorizontalAlignment="Center">
                <TextBlock x:Name="NumberText" FontFamily="{StaticResource DisplayFont}" FontSize="200" FontWeight="SemiBold"
                           Foreground="{DynamicResource AccentBrush}" HorizontalAlignment="Center" LineHeight="200"
                           LineStackingStrategy="BlockLineHeight" />
                <TextBlock x:Name="RoleText" FontFamily="{StaticResource DisplayFont}" FontSize="52" FontWeight="SemiBold"
                           HorizontalAlignment="Center" />
                <TextBlock x:Name="DetailText" FontSize="24" Foreground="{StaticResource MutedBrush}"
                           HorizontalAlignment="Center" Margin="0,8,0,0" />
            </StackPanel>
        </Border>
    </Grid>
</Window>
